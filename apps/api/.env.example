# Copia este archivo a apps/api/.env (ignorado por git). Solo contiene ejemplos, sin secretos.
# Lo cargan la API (main.ts) y Prisma CLI (prisma.config.ts) con la misma función loadApiEnv().
PORT=3001
HOST=127.0.0.1
# Ruta del archivo SQLite. Relativa => se resuelve desde apps/api/. Absoluta => tal cual.
DB_PATH=data/tasks.db
NODE_ENV=development
