generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

// Las restricciones CHECK (estado válido y longitudes) no las expresa Prisma: se añaden a mano
// en prisma/migrations/*_init/migration.sql. Los límites coinciden con packages/shared.
model Task {
  id        Int      @id @default(autoincrement())
  title     String
  assignee  String
  status    String   @default("pending")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @map("updated_at")

  @@index([status], map: "idx_tasks_status")
  @@map("tasks")
}
